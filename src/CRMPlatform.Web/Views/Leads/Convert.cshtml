@model CRMPlatform.Web.Models.ViewModels.LeadConversionViewModel
@{
    ViewData["Title"] = "Convert Lead";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-success text-white py-3">
                <h5 class="card-title mb-0 fw-bold">Convert Lead: @Model.LeadName</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Convert" method="post">
                    <input type="hidden" asp-for="LeadId" />
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <h6 class="fw-bold border-bottom pb-2 mb-3">1. New Customer Information</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="CompanyName" class="form-label fw-semibold"></label>
                            <input asp-for="CompanyName" class="form-control" />
                            <span asp-validation-for="CompanyName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ContactName" class="form-label fw-semibold"></label>
                            <input asp-for="ContactName" class="form-control" />
                            <span asp-validation-for="ContactName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold"></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-semibold"></label>
                            <input asp-for="Phone" class="form-control" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                    </div>

                    <h6 class="fw-bold border-bottom pb-2 mb-3">2. Initial Opportunity Pipeline</h6>
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" asp-for="CreateOpportunity" id="toggleOpp">
                        <label class="form-check-label fw-semibold" for="toggleOpp">Create Initial Opportunity Record</label>
                    </div>

                    <div id="oppSection" class="row g-3">
                        <div class="col-12">
                            <label asp-for="OpportunityName" class="form-label fw-semibold"></label>
                            <input asp-for="OpportunityName" class="form-control" />
                            <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="OpportunityAmount" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="OpportunityAmount" class="form-control" step="0.01" />
                            </div>
                            <span asp-validation-for="OpportunityAmount" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ExpectedCloseDate" class="form-label fw-semibold"></label>
                            <input asp-for="ExpectedCloseDate" class="form-control" type="date" />
                            <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-success px-4">Complete Conversion</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('toggleOpp').addEventListener('change', function () {
            document.getElementById('oppSection').style.display = this.checked ? 'flex' : 'none';
        });
    </script>
}