@{
    ViewData["Title"] = "Access Denied";
    Layout = "_Layout";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <div class="card border-danger shadow-sm p-4">
            <div class="card-body">
                <h1 class="display-4 text-danger fw-bold">403</h1>
                <h4 class="mb-3">Access Denied</h4>
                <p class="text-muted mb-4">
                    You do not have the required role or permissions to view this resource. 
                    If you believe this is an error, please contact your administrator.
                </p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">Return to Home</a>
            </div>
        </div>
    </div>
</div>