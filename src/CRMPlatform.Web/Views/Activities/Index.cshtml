@model CRMPlatform.Web.Models.ViewModels.ActivityDashboardViewModel
@{
    ViewData["Title"] = "Activity Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">Tasks & Follow-Ups</h2>
    <a asp-action="Schedule" class="btn btn-primary">+ Schedule Follow-Up</a>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card shadow-sm border-danger">
            <div class="card-header bg-danger text-white py-3">
                <h5 class="card-title mb-0 fw-bold">Overdue Follow-Ups (@Model.OverdueFollowUps.Count())</h5>
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush">
                    @if (!Model.OverdueFollowUps.Any())
                    {
                        <li class="list-group-item text-muted py-3 text-center">No overdue activities. Great job!</li>
                    }
                    @foreach (var task in Model.OverdueFollowUps)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                            <div>
                                <span class="badge bg-danger me-2">@task.FollowUpType</span>
                                <strong>@task.Subject</strong>
                                <div class="small text-danger">Scheduled: @task.ScheduledDate.ToString("yyyy-MM-dd")</div>
                                <div class="small text-muted">Client: @(task.Customer?.CompanyName ?? task.Lead?.LeadName ?? "General")</div>
                            </div>
                            <form asp-action="Complete" method="post">
                                <input type="hidden" name="id" value="@task.FollowUpId" />
                                <button type="submit" class="btn btn-sm btn-outline-success">Mark Done</button>
                            </form>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white py-3">
                <h5 class="card-title mb-0 fw-bold">Upcoming Follow-Ups (@Model.UpcomingFollowUps.Count())</h5>
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush">
                    @if (!Model.UpcomingFollowUps.Any())
                    {
                        <li class="list-group-item text-muted py-3 text-center">No follow-ups currently scheduled.</li>
                    }
                    @foreach (var task in Model.UpcomingFollowUps)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                            <div>
                                <span class="badge bg-primary me-2">@task.FollowUpType</span>
                                <strong>@task.Subject</strong>
                                <div class="small text-muted">Due: @task.ScheduledDate.ToString("yyyy-MM-dd")</div>
                                <div class="small text-muted">Client: @(task.Customer?.CompanyName ?? task.Lead?.LeadName ?? "General")</div>
                            </div>
                            <form asp-action="Complete" method="post">
                                <input type="hidden" name="id" value="@task.FollowUpId" />
                                <button type="submit" class="btn btn-sm btn-outline-success">Mark Done</button>
                            </form>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-light py-3">
                <h6 class="card-title mb-0 fw-bold">Recent System Activity Feed</h6>
            </div>
            <div class="card-body">
                <ul class="timeline list-unstyled mb-0">
                    @foreach (var act in Model.RecentActivities)
                    {
                        <li class="mb-3 pb-2 border-bottom">
                            <span class="badge bg-secondary me-2">@act.ActivityDate.ToString("MMM dd, HH:mm")</span>
                            <strong>@act.ActivityType</strong>: @act.Description
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>