@model CRMPlatform.Domain.Entities.Customer
@{
    ViewData["Title"] = $"{Model.CompanyName} - Details";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">&larr; Back to Customers</a>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white py-3">
                <h5 class="card-title mb-0">@Model.CompanyName</h5>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Contact</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.CustomerName</dd>
                    <dt class="col-sm-4 text-muted">Email</dt>
                    <dd class="col-sm-8">@Model.Email</dd>
                    <dt class="col-sm-4 text-muted">Phone</dt>
                    <dd class="col-sm-8">@Model.Phone</dd>
                    <dt class="col-sm-4 text-muted">Address</dt>
                    <dd class="col-sm-8">@(Model.Address ?? "N/A")</dd>
                    <dt class="col-sm-4 text-muted">Status</dt>
                    <dd class="col-sm-8"><span class="badge bg-success">@Model.Status</span></dd>
                </dl>
                <div class="mt-4 pt-3 border-top d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.CustomerId" class="btn btn-outline-primary btn-sm flex-grow-1">Edit</a>
                    <a asp-controller="Activities" asp-action="Schedule" asp-route-customerId="@Model.CustomerId" class="btn btn-outline-dark btn-sm flex-grow-1">+ Follow-Up</a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-light d-flex justify-content-between align-items-center py-3">
                <h6 class="mb-0 fw-bold">Active Opportunities</h6>
                <a asp-controller="Opportunities" asp-action="Create" class="btn btn-sm btn-outline-primary">+ New Deal</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Deal</th>
                            <th>Amount</th>
                            <th>Probability</th>
                            <th>Stage</th>
                            <th>Close Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Opportunities.Any())
                        {
                            <tr><td colspan="5" class="text-center text-muted py-3">No active opportunities.</td></tr>
                        }
                        @foreach (var opp in Model.Opportunities)
                        {
                            <tr>
                                <td class="fw-semibold">@opp.OpportunityName</td>
                                <td>@opp.Amount.ToString("C")</td>
                                <td>@opp.Probability%</td>
                                <td><span class="badge bg-primary">@opp.Stage</span></td>
                                <td>@(opp.ExpectedCloseDate?.ToString("yyyy-MM-dd") ?? "TBD")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>